# ==========================================
# TrueTips Environment Configuration
# ==========================================

# ─── DATABASE (Render Backend) ────────────
DATABASE_URL=postgresql://truetips_db_user:PASSWORD@host.render.com/truetips_db

# ─── AUTHENTICATION (Render Backend) ──────
JWT_SECRET=your-production-jwt-secret-key-min-32-chars

# ─── M-PESA DARAJA INTEGRATION (Render Backend) ──
MPESA_ENVIRONMENT=sandbox # sandbox or production
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_shortcode_or_paybill
MPESA_TILL_NUMBER=your_till_number
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_CALLBACK_URL=https://your-render-app.onrender.com

# ─── ONFON SMS INTEGRATION (Render Backend) ─────
SMS_PROVIDER=onfon # onfon or safaricom
ONFON_API_KEY=your_onfon_api_key
ONFON_CLIENT_ID=your_onfon_client_id
ONFON_SENDER_ID=your_onfon_sender_id

# ─── FRONTEND CONFIGURATION (Vercel) ──────
VITE_API_BASE_URL=https://your-render-app.onrender.com
