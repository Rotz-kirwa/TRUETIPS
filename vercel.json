{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/server.js": {
      "maxDuration": 30,
      "includeFiles": "dist/server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/payments/c2b/confirmation",
      "destination": "https://moonlight-games.onrender.com/api/payments/c2b/confirmation"
    },
    {
      "source": "/api/payments/c2b/validation",
      "destination": "https://moonlight-games.onrender.com/api/payments/c2b/validation"
    },
    { "source": "/(.*)", "destination": "/api/server" }
  ]
}
